# =============================================================================
# Crestview Capital Group — AI Onboarding Pipeline
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Configuration -------------------------------------------------------
# Provider selector: "anthropic" (default) or "azure"
# Switching to "azure" automatically routes all LLM calls through Azure OpenAI
# using the AZURE_* variables below — no other code changes needed.
LLM_PROVIDER=anthropic

# Anthropic — required when LLM_PROVIDER=anthropic
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI — required when LLM_PROVIDER=azure
# Find these in Azure Portal > your OpenAI resource > Keys and Endpoint.
AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_API_BASE=https://<your-resource-name>.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# LiteLLM model string — always required.
# Anthropic: anthropic/claude-sonnet-4-6 | Azure: azure/<deployment-name> | OpenAI: openai/gpt-4o
LLM_MODEL=anthropic/claude-sonnet-4-6

# Set to true to enable LLM tool calling in Stage 1 (sanctions, PEP, jurisdiction lookups).
# Set to false to run Stage 1 in plain completion mode for comparison.
ENABLE_TOOLS=true

# --- monday.com Integration --------------------------------------------------
# Get your API key from: https://[yourworkspace].monday.com/admin/api-tokens
# or via monday.com > Avatar > Admin > API
MONDAY_API_KEY=eyJhbGciOiJIxxxxxxxxxxxxxxxxxxxxxxxxx

# monday.com main onboarding board — find the ID in the board URL: monday.com/boards/XXXXXXXXXX
MONDAY_BOARD_ID=

# monday.com evaluation board — separate board for pipeline quality scores
MONDAY_EVAL_BOARD_ID=

# --- Pipeline Configuration --------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Semantic version tag embedded in all pipeline outputs for traceability.
PIPELINE_VERSION=0.1.0

# Number of retry attempts for failed LLM calls before raising.
MAX_RETRIES=3

# Base seconds for exponential backoff between retries (actual wait = base^attempt).
RETRY_BACKOFF_BASE=2

# --- Evaluation --------------------------------------------------------------
# Set to true to run LLM-as-judge evaluation after each application is processed.
# Adds ~1 LLM call per application; set to false for faster runs.
RUN_EVALUATIONS=true

# Model used for the independent evaluator judge. Follows LLM_PROVIDER by default.
# Set explicitly to override (e.g. keep evaluator on Anthropic while pipeline runs on Azure).
EVALUATOR_MODEL=anthropic/claude-sonnet-4-6

# --- Database ----------------------------------------------------------------
# SQLite file path for pipeline persistence (tables created automatically).
DATABASE_PATH=data/crestview_pipeline.db

# Set to true to store raw LLM response text in the database (increases storage).
RAW_LLM_RESPONSES=false

# --- File Output -------------------------------------------------------------
# Directory for per-run file output (run_summary.json, compliance reports, etc.).
OUTPUT_DIR=outputs

# --- Agent 1: Document Extraction --------------------------------------------
# Confidence threshold (0.0 to 1.0): extracted fields below this score are
# treated as "not reliably extracted" and trigger ops review or client return.
CONFIDENCE_THRESHOLD=0.7
